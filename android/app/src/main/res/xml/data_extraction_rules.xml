<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 and newer: cloud backup and moving to a new phone keep the database and settings. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="." />
        <include domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="." />
        <include domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
